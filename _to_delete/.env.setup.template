# Console setup scripts (scripts/setup). Copy the keys you need into the repo-root .env (gitignored).
APP_ID=app.fourki.wizzn
APP_NAME=wizzn

# ── Google / Firebase (pnpm setup:google) — auth via `gcloud auth login`
GCP_PROJECT_ID=wizzn-app            # globally unique, 6–30 chars, lowercase
GCP_BILLING_ACCOUNT=                # optional, e.g. 012345-ABCDEF-678901 (gcloud billing accounts list)
GCP_ORG_ID=                         # optional
ANDROID_SHA1=                       # comma-separated: debug + release/Play signing SHA-1
ANDROID_SHA256=                     # optional, comma-separated

# ── Apple (pnpm setup:apple) — App Store Connect API key, role Admin
APPLE_TEAM_ID=                      # 10 chars, developer.apple.com → Membership
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=secrets/AuthKey_ASC.p8
APP_STORE_ID=                       # filled in after the app record exists (printed by setup:apple)

# ── Keys created by hand in the Apple portal (no API)
APNS_KEY_ID=
APNS_KEY_PATH=secrets/AuthKey_APNS.p8
APPLE_SIWA_KEY_ID=
APPLE_SIWA_KEY_PATH=secrets/AuthKey_SIWA.p8
APPLE_SERVICES_ID=                  # optional, for Apple sign-in on Android/web
