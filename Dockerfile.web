# Mobile web app (Quasar SPA) → static files behind nginx. API_URL is baked in at build time.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
ARG API_URL
ARG GOOGLE_WEB_CLIENT_ID=""
ENV API_URL=${API_URL} GOOGLE_WEB_CLIENT_ID=${GOOGLE_WEB_CLIENT_ID}
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
RUN pnpm install --filter @wizzn/web... --ignore-scripts
COPY packages/shared packages/shared
COPY packages/web packages/web
RUN pnpm --filter @wizzn/shared build && cd packages/web && pnpm exec quasar prepare && pnpm exec quasar build

FROM nginx:1.27-alpine
COPY deploy/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/web/dist/spa /usr/share/nginx/html
