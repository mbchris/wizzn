# Admin SPA → static files behind nginx. API_URL is baked in at build time.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
ARG API_URL
ENV API_URL=${API_URL}
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/admin/package.json packages/admin/
RUN pnpm install --filter @wizzn/admin... --ignore-scripts
COPY packages/shared packages/shared
COPY packages/admin packages/admin
RUN pnpm --filter @wizzn/shared build && cd packages/admin && pnpm exec quasar prepare && pnpm exec quasar build

FROM nginx:1.27-alpine
COPY deploy/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/admin/dist/spa /usr/share/nginx/html
