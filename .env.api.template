NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wizzn:wizzn@localhost:5432/wizzn
BETTER_AUTH_SECRET=change-me-min-32-characters-long-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:9000,http://localhost:9100,capacitor://localhost,http://localhost

# LLM: openai (Ollama on the Mac or any OpenAI-compatible API) | gemini-cli (local `gemini` binary, uses its own login/GEMINI_API_KEY)
#      | requesty (Requesty router; LLM_MODEL=provider/model, e.g. google/gemini-2.5-flash or openai/gpt-4o-mini)
LLM_PROVIDER=openai
# gemini-cli: LLM_MODEL=gemini-2.5-flash (empty = CLI default); LLM_BASE_URL/LLM_API_KEY are ignored
# GEMINI_CLI_BIN=gemini
# GEMINI_CLI_TIMEOUT_MS=300000
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
SEARCH_URL=http://localhost:8080
# Requesty (https://requesty.ai) — needed when LLM_PROVIDER or TTS_PROVIDER is requesty
REQUESTY_API_KEY=
# REQUESTY_BASE_URL=https://router.requesty.ai/v1
# TTS_PROVIDER=requesty: openai/gpt-4o-mini-tts (supports TTS_INSTRUCTIONS) | openai/tts-1 | openai/tts-1-hd
# REQUESTY_TTS_MODEL=deepinfra/ResembleAI/chatterbox-multilingual   # native German; or openai/gpt-4o-mini-tts (English accent)
# REQUESTY_TTS_LANGUAGE=de        # non-OpenAI models only
# REQUESTY_TTS_VOICE=             # openai/*: alloy|ash|ballad|coral|echo|fable|onyx|nova|sage|shimmer|verse; others: passed through, empty = model default
# REQUESTY_TTS_CHUNK_CHARS=0      # 0 = auto (openai 3500, others 300); whole sentences only
# TTS_INSTRUCTIONS only applies to openai/gpt-4o-mini-tts. TTS_VOICE / TTS_VOICE_1..3 are not used by requesty.
# TTS_INSTRUCTIONS=Sprich Deutsch, warm, ruhig und sachlich.
# TTS: silent | piper | chatterbox | qwen | requesty (cloud, voice via REQUESTY_TTS_VOICE) — chatterbox/qwen: natural German, local on the Mac, need `brew install uv`.
# Details: docs/tts.md
TTS_PROVIDER=silent
TTS_URL=http://localhost:5100/synthesize
# piper: voice name (de_DE-thorsten-high)
# chatterbox: path to a ~10 s clean German reference WAV (repo-relative); anything else = built-in voice
# qwen: ref WAV (+ same-name .txt transcript) | design:<voice description> | preset speaker, e.g. Serena or Serena|ruhig, sachlich (no quotes)
TTS_VOICE=de_DE-thorsten-high
# qwen only: 1.7B (better) | 0.6B (faster)
TTS_QWEN_SIZE=1.7B
# Pace: >1 = slower. Piper: 1.2 ≈ 140 wpm. chatterbox/qwen: start at 1 (applied as a time-stretch)
TTS_LENGTH_SCALE=1.2
IMAGE_PROVIDER=placeholder
# IMAGE_BASE_URL=https://api.example.com/v1
# IMAGE_MODEL=
# IMAGE_API_KEY=
# ImageRouter (AI fallback for images):
# IMAGE_PROVIDER=api
# IMAGE_BASE_URL=https://api.imagerouter.io/v1/openai
# IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
# IMAGE_API_KEY=
# true = response_format b64_ephemeral (no 30-day retention at ImageRouter)
IMAGE_EPHEMERAL=true

# CC-licensed stock images. Comma-separated, in order: openverse,commons. Empty disables stock.
STOCK_IMAGE_PROVIDERS=openverse,commons
# Required when commons is enabled (Wikimedia user-agent policy)
STOCK_USER_AGENT=wizzn/1.0 (https://wizzn.app; ops@wizzn.app)
# Optional Openverse OAuth for higher quota — `pnpm setup:openverse` registers an app and fills these
# (needs OPENVERSE_EMAIL; optional OPENVERSE_APP_NAME / OPENVERSE_APP_DESCRIPTION)
OPENVERSE_EMAIL=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
STOCK_MIN_EDGE_PX=800
STOCK_MAX_BYTES=5000000

# Comma-separated; these accounts may use the admin app
ADMIN_EMAILS=

MEDIA_DRIVER=local
MEDIA_DIR=./media-data
MEDIA_PUBLIC_URL=http://localhost:8081
FREE_DAILY_CAP=3

REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

APPLE_APP_BUNDLE_ID=app.fourki.wizzn
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
# Knowledge sources (issue #4): tier decides order; drop "web" to disable the open-web fallback.
# wikipedia also needs STOCK_USER_AGENT (Wikimedia API policy).
RESEARCH_PROVIDERS=curated,wikipedia,europepmc,web
RESEARCH_MIN_SOURCES=2
