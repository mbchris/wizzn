{
  "name": "wizzn",
  "private": true,
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/api dev",
    "dev:worker": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/api dev:worker",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @wizzn/shared build && pnpm -r typecheck",
    "db:generate": "pnpm --filter @wizzn/api db:generate",
    "db:migrate": "pnpm --filter @wizzn/api db:migrate",
    "db:seed": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/api db:seed",
    "build:shared": "pnpm --filter @wizzn/shared build",
    "dev:admin": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/admin dev",
    "dev:all": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/web dev",
    "db:seed:samples": "pnpm --filter @wizzn/shared build && pnpm --filter @wizzn/api db:seed:samples",
    "setup:google": "node --env-file=.env scripts/setup/google.mjs",
    "setup:apple": "node --env-file=.env scripts/setup/apple.mjs",
    "setup:apple:secret": "node --env-file=.env scripts/setup/apple-client-secret.mjs",
    "verify:m4": "node scripts/verify-m4.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
