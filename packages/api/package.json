{
  "name": "@wizzn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:seed:samples": "tsx --env-file=../../.env src/db/seed-samples.ts",
    "llm:check": "tsx --env-file=../../.env src/scripts/llm-check.ts",
    "tts:entry": "tsx --env-file=../../.env src/scripts/tts-entry.ts",
    "audio:rerender": "tsx --env-file=../../.env src/scripts/rerender-audio.ts",
    "links:backfill": "tsx --env-file=../../.env src/scripts/links-backfill.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.0",
    "@wizzn/shared": "workspace:*",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.8.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
